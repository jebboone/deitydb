# DeityDB local environment — copy to .env (which is gitignored) and adjust if needed.
#
# dbmate reads DATABASE_URL to manage schema migrations in db/migrations/.
# This points at the local Docker Postgres source-of-truth (see docs/RESUME.md).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/deitydb?sslmode=disable"

# Keep dbmate scoped to db/migrations/ and stop it writing a db/schema.sql dump —
# the canonical schema already lives in schema/*.sql and the committed PG dump.
DBMATE_MIGRATIONS_DIR="./db/migrations"
DBMATE_NO_DUMP_SCHEMA="true"
